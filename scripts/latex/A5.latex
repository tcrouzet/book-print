% Forcer des puces (•) au lieu des tirets cadratins pour les listes
\AtBeginDocument{%
  \renewcommand{\labelitemi}{\textbullet}%
  \renewcommand{\labelitemii}{\textbullet}%
  \renewcommand{\labelitemiii}{\textbullet}%
  \renewcommand{\labelitemiv}{\textbullet}%
}

% Espace avant la première puce et après la dernière d'une liste
\AtBeginDocument{%
  \let\oldpandocitemize\itemize
  \let\endoldpandocitemize\enditemize
  \renewenvironment{itemize}{%
    \vspace{\mylinespacing}%
    \oldpandocitemize
  }{%
    \endoldpandocitemize
    \vspace{\mylinespacing}%
  }%
}


% Conserver votre format pour le contenu des notes
\renewcommand\enoteformat{%
  \rightskip\z@
  \leftskip\z@
  \parindent=1em
  \fontsize{8pt}{9.5pt}\selectfont % Taille explicite en points
  \leavevmode\llap{\makeenmark}%
}
\makeatother

% Images sans légende
\newcommand{\pandocbounded}[1]{%
  \begin{center}
    \sbox0{#1}%
    \ifdim\ht0>\textheight
      \resizebox*{\textwidth}{!}{#1}%
    \else
      #1%
    \fi
  \end{center}
}

% Désactiver la numérotation des titres
\setcounter{secnumdepth}{0}

% Styles pour les liens
\hypersetup{
  colorlinks=true,
  linkcolor=blue,
  filecolor=magenta,
  urlcolor=cyan,
}

% Configuration des blocs de code
\fvset{
  % samepage=true,
  frame=none,
  framesep=0pt,
  fontsize=\fontsize{9pt}{\mylinespacing}\selectfont,
  baselinestretch=1
}

% Pour les blocs Highlighting (pandoc)
\DefineVerbatimEnvironment{Highlighting}{Verbatim}{
  commandchars=\\\{\},
  samepage=false,
  frame=none,
  framesep=0pt,
  fontsize=\fontsize{9pt}{\mylinespacing}\selectfont,
  baselinestretch=1,
  mathescape=false,
  breaklines=true,
  breaksymbolleft=,
  breaksymbolright=,
  breakanywhere=true
}

% Pour les listes "compactes" générées par Pandoc
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}%
  \setlength{\parskip}{0pt}%
}

% Définitions pour la coloration syntaxique (tout en noir)
% \newenvironment{Shaded}{}{}

\newenvironment{Shaded}{%
  \par
}{%
  \par
}

\newcommand{\KeywordTok}[1]{\textbf{#1}}
\newcommand{\DataTypeTok}[1]{#1}
\newcommand{\DecValTok}[1]{#1}
\newcommand{\BaseNTok}[1]{#1}
\newcommand{\FloatTok}[1]{#1}
\newcommand{\ConstantTok}[1]{#1}
\newcommand{\CharTok}[1]{#1}
\newcommand{\SpecialCharTok}[1]{#1}
\newcommand{\StringTok}[1]{#1}
\newcommand{\VerbatimStringTok}[1]{#1}
\newcommand{\SpecialStringTok}[1]{#1}
\newcommand{\ImportTok}[1]{#1}
\newcommand{\CommentTok}[1]{\textit{#1}}
\newcommand{\DocumentationTok}[1]{\textit{#1}}
\newcommand{\AnnotationTok}[1]{\textit{#1}}
\newcommand{\CommentVarTok}[1]{\textit{#1}}
\newcommand{\OtherTok}[1]{#1}
\newcommand{\FunctionTok}[1]{#1}
\newcommand{\VariableTok}[1]{#1}
\newcommand{\ControlFlowTok}[1]{\textbf{#1}}
\newcommand{\OperatorTok}[1]{\textbf{#1}}
\newcommand{\BuiltInTok}[1]{#1}
\newcommand{\ExtensionTok}[1]{#1}
\newcommand{\PreprocessorTok}[1]{\textit{#1}}
\newcommand{\AttributeTok}[1]{#1}
\newcommand{\RegionMarkerTok}[1]{#1}
\newcommand{\InformationTok}[1]{\textit{#1}}
\newcommand{\WarningTok}[1]{\textit{#1}}
\newcommand{\AlertTok}[1]{#1}
\newcommand{\ErrorTok}[1]{\textbf{#1}}
\newcommand{\NormalTok}[1]{#1}


% Pour faire entrer ligne creuse (à utiliser en début et fin de paragraphes)
\newcommand{\tightopen}{%
  \par\begingroup
  \spaceskip=0.33em plus 0.22em minus 0.14em
  \xspaceskip=\spaceskip
}
\newcommand{\tightclose}{\par\endgroup}

% Élargissement léger
\newcommand{\wideropen}{%
  \par\begingroup
  % Base plus large que ton global (0.35em), avec un peu de flex
  \spaceskip=0.37em plus 0.24em minus 0.12em
  \xspaceskip=\spaceskip
  \ignorespaces
}
\newcommand{\widerclose}{\unskip\par\endgroup}



% Structure document
\begin{document}

% Page titre

$if(title)$
\title{$title$}
$endif$

$if(author)$
\author{$author$}
$endif$

$if(date)$
\date{$date$}
$endif$

$if(charcount)$
\date{$charcount$}
$endif$

$if(subtitle)$
\newcommand{\subtitle}{$subtitle$}
$endif$

$if(publisher)$
\newcommand{\publisher}{$publisher$}
$endif$

$if(rights)$
\newcommand{\rights}{$rights$}
$endif$

$if(charcount)$
\newcommand{\charcount}{$charcount$K signes}
$endif$

% Page de titre personnalisée
$if(title)$
\begin{titlepage}
    \centering
    {\huge\bfseries $title$\par}
    $if(subtitle)$
    \vspace{0.5cm}
    {\large $subtitle$\par}
    $endif$
    \vspace{2cm}
    $if(author)$
    {\large $author$\par}
    $endif$
    \vfill
    $if(publisher)$
    {\large $publisher$\par}
    $endif$
    \vspace{0.5cm}
    $if(charcount)$
    \vspace{0.5cm}
    {\small \charcount\par}
    $endif$
    $if(date)$
    \vspace{0.5cm}
    {\small $date$\par}
    $endif$
    $if(rights)$
    \vspace{0.5cm}
    {\small $rights$\par}
    $endif$
\end{titlepage}
$endif$

$if(toc)$
\tableofcontents
$endif$

% \vspace*{8\baselineskip}

$body$

% Afficher les notes à la fin du document
\clearpage
\begingroup
\parindent 0pt
\parskip 1ex
\def\enotesize{\small}
% \theendnotes
\endgroup

\end{document}
