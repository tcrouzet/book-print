\usepackage[all]{nowidow}


% Simplification de la gestion des notes de bas de page
\usepackage{endnotes}
\let\footnote=\endnote


% Typographie française impeccable
% https://mirrors.mit.edu/CTAN/macros/latex/contrib/impnattypo/impnattypo-fr.pdf
\usepackage[
  hyphenation,    % Améliore les césures françaises
  parindent,      % Gère les alinéas trop courts
  lastparline,    % Évite les dernières lignes de paragraphe trop courtes
  rivers = 4      % Évite les "rivières" de blanc dans le texte
]{impnattypo}

\usepackage{newunicodechar}
\newfontfamily\macronsfont{Garamond Premier Pro}[Scale=MatchLowercase]
\newunicodechar{ū}{{\macronsfont ū}}
\newunicodechar{ī}{{\macronsfont ī}}

% Configuration manuelle des aspects typographiques français
\frenchbsetup{
  IndentFirst=false,         % Ne pas indenter le premier paragraphe d'une section
  FrenchFootnotes=false,     % Pas de notes de bas de page à la française 
  AutoSpacePunctuation=true, % Espace automatique avant la ponctuation haute
  ThinColonSpace=true,       % Espace fine avant les deux-points
  og=«,                      % Guillemet ouvrant français
  fg=»,                      % Guillemet fermant français
  InnerGuillSingle=true,     % Guillemets simples à l'intérieur des guillemets doubles
  ThinSpaceInFrenchNumbers=true,      % Espace fine dans les nombres
  FrenchSuperscripts=true,
  OriginalTypewriter=true,
}

% Éviter seulement les très mauvaises césures
\exhyphenpenalty=10000
\tolerance=1000
\emergencystretch=3em

% Définir les espaces inter-mots
\spaceskip=0.35em plus 0.25em minus 0.15em % Contrôle précis de l'espace entre les mots

% Configuration de la géométrie de la page
\geometry{
  a5paper,
  inner=28mm,
  outer=25mm,   % textwidth = 148-28-25 = 95mm
  top=15mm,
  bottom=27mm,  % +3mm pour ~3 lignes supplémentaires
  footskip=12mm
}

% Configuration grille
\newlength{\mylinespacing}
\setlength{\mylinespacing}{14pt}
\setlength{\topskip}{\mylinespacing}


% Configuration des polices
\defaultfontfeatures{Ligatures=TeX, Mapping=tex-text}
\SetExtraKerning{encoding={*}, family={*}, series={*}, size={*}}{}
% \setmainfont{Playfair Display}
% \setsansfont{Playfair Display}
\setmainfont{Garamond 3 LT Std}  % Regular/Italic/Bold/BoldItalic auto-détectés
\setsansfont{Garamond 3 LT Std}  % idem corps
% \setmainfont{FreightTextProBook-Regular}
% \setsansfont{FreightTextProBook-Regular}
\newfontfamily\titrefont{Garamond 3 LT Std} 

% Définir la taille de police exacte/interlignage
\makeatletter
\renewcommand\normalsize{%
   \@setfontsize\normalsize{12pt}{\mylinespacing}%
   \abovedisplayskip 10\p@ \@plus2\p@ \@minus5\p@
   \abovedisplayshortskip \z@ \@plus3\p@
   \belowdisplayshortskip 6\p@ \@plus3\p@ \@minus3\p@
   \belowdisplayskip \abovedisplayskip
   \let\@listi\@listI}
\makeatother

\setlength{\parskip}{0pt}  % Supprime l'espace entre paragraphes
\setlength{\parindent}{1.2em}  % Indentation des paragraphes


% Configuration des en-têtes et pieds de page
\pagestyle{fancy}
\fancyhf{} % Efface tous les champs d'en-tête et de pied de page
\fancyfoot[LE]{\sffamily\fontsize{9pt}{9pt}\selectfont\thepage} % Page à gauche sur les pages paires
\fancyfoot[RO]{\sffamily\fontsize{9pt}{9pt}\selectfont\thepage} % Page à droite sur les pages impaires
\renewcommand{\headrulewidth}{0pt} % Pas de ligne d'en-tête
\renewcommand{\footrulewidth}{0pt} % Pas de ligne de pied de page


% S'assurer que le style plain (utilisé pour les premières pages de chapitre) est cohérent
\fancypagestyle{plain}{
    \fancyhf{} % Efface tous les champs
    \fancyfoot[LE]{\sffamily\fontsize{9pt}{9pt}\selectfont\thepage} % Page à gauche sur les pages paires
    \fancyfoot[RO]{\sffamily\fontsize{9pt}{9pt}\selectfont\thepage} % Page à droite sur les pages impaires
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
}


% H1 (chapter) — page de droite seule, centré, petites capitales, non gras
%   baseline à 70mm du haut de page (top margin=15mm → \vspace*{55mm})
%   positionne \iffirstsection=true pour que le H2 suivant aille en page de droite
\newif\iffirstsection
\firstsectionfalse
\makeatletter
\newcounter{chaptercount}
\setcounter{chaptercount}{0}
\renewcommand{\chapter}[1]{%
  \stepcounter{chaptercount}%
  \cleardoublepage
  \thispagestyle{empty}%
  \null\vskip-\topskip%
  \vspace*{55mm}%
{\centering\fontsize{28}{28}\selectfont\mdseries #1\par}%
  \global\firstsectiontrue%
  \@afterheading%
}%
\makeatother



% H2 (chapter) — page de droite seule, centré, petites capitales, non gras
%   baseline à 70mm du haut de page (top margin=15mm → \vspace*{55mm})
%   positionne \iffirstsection=true pour que le H2 suivant aille en page de droite

\makeatletter
\renewcommand{\section}[1]{%
  \stepcounter{chaptercount}%
  \cleardoublepage
  \thispagestyle{empty}%
  \null\vskip-\topskip%
  \vspace*{55mm}%
{\centering\fontsize{20}{28}\selectfont\scshape\mdseries #1\par}%
\vspace{5\mylinespacing}%
\global\firstsectiontrue%
\@afterheading%
\everypar{%
  \par
  \cleardoublepage
  \vspace*{50mm}%
  \everypar{\setbox\z@\lastbox\everypar{}}%
}%
}%
\makeatother



% H3 (section) — haut de page, aligné gauche, italique, 12pt
%   premier H3 après un H1 : page de droite (\cleardoublepage)
%   H3 suivants : nouvelle page indifféremment (\clearpage)
%   corps du texte ~50mm sous la baseline du titre H2
\makeatletter
\newcounter{subsectioncount}
\setcounter{subsectioncount}{0}
\renewcommand{\subsection}[1]{%
  \stepcounter{subsectioncount}%
  \ifnum\value{subsectioncount}=1
    \cleardoublepage%
  \else
    \iffirstsection
      \cleardoublepage%
      \global\firstsectionfalse%
    \else
      \clearpage%
    \fi
  \fi
  \null\vskip-\topskip%
  {\normalfont\normalsize\itshape\noindent #1\par}%
  \vspace{50mm}%
  \@afterheading%
  \global\@afterindentfalse%
}
\makeatother

% \renewcommand{\section}[1]{%
%   \stepcounter{chaptercount}%
%   \cleardoublepage
%   \thispagestyle{empty}%
%   \null\vskip-\topskip%
%   \vspace*{55mm}%
% {\centering\fontsize{20}{28}\selectfont\scshape\mdseries #1\par}%
% \vspace{5\mylinespacing}%
