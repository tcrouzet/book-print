% H4 - invisible, commence sur page impaire, non numéroté
\let\oldsubsubsection\subsubsection
\renewcommand{\subsubsection}[1]{%
  \cleardoublepage% Force page impaire
  \thispagestyle{empty}% Supprime numéro de page
  \vspace*{10\mylinespacing}% 150pt d'espace depuis le haut (10 × 15pt = 150pt)
  \phantom{#1}% Titre invisible mais structurellement présent
  \par% Force un saut de ligne
}

% H5 (paragraph) - redéfinition manuelle
\makeatletter
\renewcommand{\paragraph}[1]{%
  \par
  \noindent\hfill%
  \begin{minipage}{0.7\linewidth}
    \normalsize #1%
  \end{minipage}%
  \@afterheading
}
\makeatother


% H6 (subparagraph) - redéfinition manuelle
\makeatletter
\renewcommand{\subparagraph}[1]{%
  \vspace{0.5\mylinespacing}%
  {\normalsize\raggedleft #1\par}%
  \vspace{1.5\mylinespacing}%
  \@afterheading%
}
\makeatother


% Lettrines
\setcounter{DefaultLines}{1}
\renewcommand{\LettrineFont}{\titrefont\bfseries\scshape\MakeUppercase}
\renewcommand{\LettrineTextFont}{\normalfont}


% Quote alignée à droite avec espacement cohérent (sans double espace en série)
\makeatletter
\renewenvironment{quote}{%
    \par\addvspace{\mylinespacing}% espace avant (fusionne si déjà présent)
    \bgroup
        \itshape
        \parindent=0pt
        \leftskip=\dimexpr\parindent+1em\relax
        \rightskip=\leftskip
        \par
        \ignorespaces
}{%
        \par
    \egroup
    \addvspace{\mylinespacing}% espace après (fusionne si un autre suit)
    \ignorespacesafterend
}
\makeatother


% Définir spacer
\newcommand{\starrule}{%
  \par
  \vspace{\baselineskip}
  {\centering
    \selectfont\ding{72}
    \par
  }%
  \vspace{\baselineskip}
  \par
}

% Définir alignright
\newcommand{\alignright}[1]{%
  \par
  \vspace{\baselineskip}
  {\raggedleft
    #1
    \par
  }%
  \vspace{\baselineskip}
  \par
}

% Blochquote après H3
\makeatletter
\newcommand{\chapexergue}[1]{%
    \par % S'assure que le paragraphe précédent est terminé et que nous sommes sur une nouvelle ligne.
    \bgroup % Démarre un groupe local pour que les réglages soient temporaires.
        \itshape % Met le texte en italique.
        \leftskip=25mm % Définit la marge gauche pour toutes les lignes du paragraphe.
        \rightskip=0pt % S'assure qu'il n'y a pas de marge droite supplémentaire (par défaut est 0).
        \parindent=0pt
        \sloppy
        #1\par % Le contenu de l'exergue, suivi d'une fin de paragraphe.
    \egroup % Termine le groupe local pour réinitialiser les marges et le style.
}
\makeatother


% Bloquote book exergue après H4
\makeatletter
\newcommand{\bookexergue}[1]{%
    % \par\vspace*{\mylinespacing}% % Espace vertical avant
    \bgroup % Démarre un groupe local pour les réglages
        \itshape % Met le texte en italique
        \parindent=0pt % Pas d'indentation de première ligne interne
        \leftskip=\dimexpr\parindent+7em\relax % Décale le bloc de 1 parindent depuis la marge gauche
        \rightskip=\dimexpr\parindent\relax % Décale le bloc de 1 parindent depuis la marge droite
        \obeylines
        #1\par % Le contenu de l'exergue, suivi d'une fin de paragraphe
    \egroup % Termine le groupe local
}
\makeatother

